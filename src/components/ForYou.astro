---
import { Image } from 'astro:assets';
import familia from '../assets/photos/familia.jpg';
import { ministries, type Ministry } from '../data/site';

interface Props {
	id?: string;
	heading?: string;
	items?: Ministry[];
	photo?: ImageMetadata;
	alt?: string;
	focus?: string;
}

const {
	id = 'para-vos',
	heading = 'IBC es para vos',
	items = ministries,
	photo = familia,
	alt = 'Una pareja joven con su bebé en brazos, sonriendo junto a los pastores en el escenario',
	focus = '50% 25%',
} = Astro.props;
---

<section class="for-you section" id={id}>
	<div class="wrap inset">
		<h2 class="title title--quiet">{heading}</h2>

		<div class="stage">
			<figure class="photo">
				<Image
					class="bw"
					src={photo}
					alt={alt}
					style={`object-position: ${focus}`}
					widths={[600, 1000, 1600]}
					sizes="(max-width: 56rem) 100vw, 60vw"
				/>
			</figure>

			<ul class="cards">
				{
					items.map((m) => (
						<li class="card item">
							<h3 class="title-s">{m.name}</h3>
							<p class="soft">{m.line}</p>
							{m.when && <p class="mono when">{m.when}</p>}
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<style>
	.stage {
		position: relative;
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		margin-top: clamp(1.75rem, 3vw, 2.5rem);
	}

	.photo {
		grid-column: 1 / span 8;
		grid-row: 1;
		position: sticky;
		top: calc(var(--header) + 1.5rem);
		align-self: start;
		aspect-ratio: 5 / 4;
		overflow: hidden;
		background: var(--ink);
	}

	.photo :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.cards {
		grid-column: 8 / -1;
		grid-row: 1;
		z-index: 1;
		display: grid;
		gap: 0.75rem;
		padding-block: clamp(2rem, 6vw, 5rem);
	}

	.item {
		display: grid;
		gap: 0.35rem;
		padding: 1.5rem 1.75rem;
	}

	.when {
		margin-top: 0.5rem;
	}

	@media (max-width: 56rem) {
		.stage {
			display: block;
		}

		.photo {
			position: static;
			aspect-ratio: 4 / 3;
		}

		.cards {
			margin: -2.5rem 0.75rem 0;
			position: relative;
			padding-block: 0;
		}
	}
</style>
