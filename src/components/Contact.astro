---
import { site } from '../data/site';

interface Props {
	heading?: string;
	sub?: string;
}

const { heading = '¿Te quedó alguna pregunta?', sub } = Astro.props;
---

<section class="contact section">
	<div class="wrap head">
		<h2 class="title">{heading}</h2>
		<p class="sub">
			{
				sub ?? (
					<>
						Escribinos o llamanos al <span class="tel">{site.phone.display}</span>. Nos va a encantar
						ayudarte.
					</>
				)
			}
		</p>
		<ul class="pills">
			<li><a class="pill" href={site.phone.href}>Llamanos</a></li>
			<li><a class="pill" href={site.social.instagram} target="_blank" rel="noopener">Instagram</a></li>
			<li><a class="pill" href={site.social.facebook} target="_blank" rel="noopener">Facebook</a></li>
		</ul>
	</div>
</section>

<style>
	.head {
		display: grid;
		justify-items: center;
		gap: 1rem;
		text-align: center;
	}

	.sub {
		max-width: 34ch;
		font-size: var(--text-l);
		text-wrap: balance;
	}

	.tel {
		white-space: nowrap;
	}

	.pills {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		margin-top: 0.75rem;
	}
</style>
