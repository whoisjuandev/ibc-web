---
import { Image } from 'astro:assets';
import predica from '../assets/photos/predica.jpg';
import Arrow from './Arrow.astro';
import { site } from '../data/site';
---

<section class="sermon section" id="predicas">
	<div class="wrap inset grid">
		<div class="text">
			<h2 class="title title--quiet">La Palabra, cada domingo</h2>
			<p class="soft">
				Cada domingo abrimos la Biblia juntos. Si no pudiste venir o querés volver a escuchar, las
				prédicas quedan en nuestro canal.
			</p>
			<a class="go" href={site.social.youtube} target="_blank" rel="noopener">
				Ver prédicas en YouTube <Arrow />
			</a>
		</div>

		<figure class="photo">
			<Image
				class="bw"
				src={predica}
				alt="Un pastor predicando con el micrófono en la mano"
				widths={[500, 800, 1200]}
				sizes="(max-width: 56rem) 100vw, 44vw"
			/>
		</figure>
	</div>
</section>

<style>
	.grid {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
		gap: clamp(2rem, 6vw, 6rem);
		align-items: center;
	}

	.text {
		display: grid;
		gap: 1.25rem;
		justify-items: start;
		max-width: 26rem;
	}

	.photo {
		aspect-ratio: 5 / 4;
		overflow: hidden;
		background: var(--ink);
	}

	.photo :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 22%;
	}

	@media (max-width: 55.99rem) {
		.grid {
			grid-template-columns: 1fr;
		}

		.photo {
			order: -1;
		}
	}
</style>
